# Docker Compose reads .env from the repo root. Copy this file to .env and
# replace each placeholder with a password of your own, for example from
# `openssl rand -hex 16`. Use letters and digits only, since the passwords
# also go into database URLs.
#
# Do this before the first `make db`: Postgres sets the passwords only while
# its volume is empty. The README says how to change them later.

# Postgres's admin user
POSTGRES_PASSWORD=your_password_here

# The metrics and gateway services' own database users
METRICS_DB_PASSWORD=your_password_here
GATEWAY_DB_PASSWORD=your_password_here
