{
  "name": "backend",
  "version": "0.1.0",
  "description": "DashGen backend: turns a question into a chart",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts | pino-pretty --translateTime SYS:HH:MM:ss --ignore pid,hostname",
    "start": "node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test \"test/integration/**/*.test.ts\"",
    "typecheck": "tsc",
    "db:generate": "DOTENV_CONFIG_PATH=/dev/null drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@dashgen/contracts": "*",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@google/genai": "^2.31.0",
    "@scalar/fastify-api-reference": "^1.76.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0"
  }
}
