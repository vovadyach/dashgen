# The model that answers questions: gemini-3.1-flash-lite, the default, whose
# prices the cost estimates in docs/design.md use, gemini-3.5-flash-lite, or
# claude-haiku-5-5. Each needs its provider's key, below.
AI_MODEL=gemini-3.1-flash-lite

# Gemini API key from https://aistudio.google.com/, for a Gemini model
GEMINI_API_KEY=your_api_key_here

# Claude API key from https://platform.claude.com/, for claude-haiku-5-5. A key
# from the Console organization linked to a Claude Max plan uses the plan's
# monthly API credits (docs/runbooks/costs.md).
# ANTHROPIC_API_KEY=your_api_key_here

# Comma-separated list of allowed CORS origins
# Local: http://localhost:5173
# Production: also add the frontend's URL
ALLOWED_ORIGINS=http://localhost:5173

# Postgres for this backend: the dashgen user and the DASHGEN_DB_PASSWORD from
# the root .env. Used by `npm run db:migrate`, `npm run db:seed` and the
# backend.
DATABASE_URL=postgres://dashgen:your_password_here@localhost:5432/dashgen

# Questions a day, for every visitor together. Raise it for a launch day,
# within Gemini's spend cap or Claude's monthly credits (docs/runbooks/costs.md).
DAILY_CAP=150

# DynamoDB Local, where the daily cap keeps its count. `make db` starts it
# here, which is also the default.
DYNAMODB_ENDPOINT=http://localhost:8000

# On AWS only: AWS's own DynamoDB in this region, with the ECS task's role,
# instead of DynamoDB Local. The backend's task definition sets it, so leave
# it unset here: outside an ECS task there are no task credentials, and every
# question would get a 503. With DYNAMODB_ENDPOINT too, the backend refuses to
# start.
# DYNAMODB_REGION=us-east-1

# On AWS only: the header with the visitor's IP, which CloudFront's function
# sends, for the per-IP rate limit. Leave it unset here: the rate limit then
# counts by the connection's address, which locally is the visitor's.
# VIEWER_IP_HEADER=x-viewer-ip

# Where the backend listens. The Dockerfile sets HOST=0.0.0.0, since in a
# container localhost is the container's own.
HOST=localhost
PORT=3000

# Log level: debug locally (adds every SQL statement), info on AWS
LOG_LEVEL=debug
