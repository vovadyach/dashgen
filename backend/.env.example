# Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Gemini model: gemini-3.1-flash-lite, whose prices the cost estimates in
# docs/design.md use, or gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite

# Comma-separated list of allowed CORS origins
# Local: http://localhost:5173
# Production: also add the frontend's URL
ALLOWED_ORIGINS=http://localhost:5173

# Postgres for this backend: the dashgen user and the DASHGEN_DB_PASSWORD from
# the root .env. Used by `npm run db:migrate`, `npm run db:seed` and the
# backend.
DATABASE_URL=postgres://dashgen:your_password_here@localhost:5432/dashgen

# Log level: debug locally (adds every SQL statement), info on AWS
LOG_LEVEL=debug
