# Node.js dependencies (regenerated by `npm install`)
node_modules/

# Python virtual environments and tool caches (regenerated by `uv sync`)
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build outputs (regenerated by build commands)
dist/
build/

# Environment variables — NEVER COMMIT THESE
.env
.env.*
!.env.example

# Log files
*.log

# OS-specific junk
.DS_Store
Thumbs.db

# Compiled Go binary (the file, not the folder)
metrics/metrics

# Editor files
.vscode/
.idea/

# Claude Code personal settings (the shared ones are in .claude/settings.json)
.claude/settings.local.json
