# Node.js dependencies (regenerated by `npm install`)
node_modules/

# Build outputs (regenerated by build commands)
dist/
build/

# Environment variables — NEVER COMMIT THESE
.env
.env.*
!.env.example

# Log files
*.log

# OS-specific junk
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Claude Code personal settings (the shared ones are in .claude/settings.json)
.claude/settings.local.json

# Terraform: the providers it downloads, and state, which can hold secrets.
# The lock file, .terraform.lock.hcl, is committed: it pins each provider.
.terraform/
*.tfstate
*.tfstate.*
# Variables' values, like an email address: only the example is committed.
*.tfvars
!*.tfvars.example
# Saved plans (terraform plan -out=tfplan): they hold variables' values and state.
tfplan
