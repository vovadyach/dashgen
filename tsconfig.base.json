{
  // Shared by every TypeScript package. Each one extends this and lists its own
  // files. Type checking only: Node runs the .ts files directly.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Node strips types without compiling, so code can't use TypeScript-only
    // syntax that generates JavaScript, such as enums or parameter properties.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}
